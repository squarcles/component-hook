{
  "manifest_version": 3,
  "name": "Component Hook",
  "version": "0.1.3",
  "description": "Récupère les prix des marchands pour Component Hook.",
  "permissions": ["tabs", "scripting"],
  "incognito": "spanning",
  "host_permissions": [
    "https://www.amazon.fr/*",
    "https://www.ldlc.com/*",
    "https://www.materiel.net/*",
    "https://www.topachat.com/*",
    "https://www.cdiscount.com/*",
    "https://www.fnac.com/*",
    "https://www.joybuy.fr/*",
    "https://*.aliexpress.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://componenthook.site/*", "https://www.componenthook.site/*", "http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
